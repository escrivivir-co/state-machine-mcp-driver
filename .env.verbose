# Verbose Mode Configuration
# Copy this to .env to enable verbose logging

# Enable verbose MCP logging
MCP_VERBOSE=true

# Disable quiet mode
MCP_QUIET=false

# Set log level to debug
LOG_LEVEL=debug

# Optional: Enable native MCP protocol
MCP_USE_NATIVE_PROTOCOL=true

# Optional: Set Ollama model
OLLAMA_MODEL=gpt-oss:20b
