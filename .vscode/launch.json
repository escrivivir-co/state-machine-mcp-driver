{
  "version": "0.2.0",
  "configurations": [
	{
      "name": "Start XPlus",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["tsx"],
      "program": "${workspaceFolder}/examples/xplus1-app/xplus1-app.ts",
      "args": [
        "examples/xplus1-app/xplus1-config.json"
      ],
      "cwd": "${workspaceFolder}",
      "env": {
        "OLLAMA_MODEL": "gpt-oss:20b",
        "MCP_QUIET": "false"
      },
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"],
      "sourceMaps": true,
      "resolveSourceMapLocations": [
        "${workspaceFolder}/**",
        "!**/node_modules/**"
      ],
      "restart": true,
      "stopOnEntry": false,
      "autoAttachChildProcesses": true,
      "outputCapture": "std"
    },
