{
  "game": {
    "id": "x-plus-1-multi",
    "name": "X+1 Multi-UI Demo",
    "description": "X+1 game running with both console and web interfaces"
  },
  "mcp": {
    "useNativeProtocol": false,
    "servers": [
      "xplus1-mcp-machine",
      "wiki-mcp-browser"
    ]
  },
  "orchestration": {
    "syncInterval": 100
  },
  "ui": [
    {
      "id": "console-primary",
      "name": "Console Interface",
      "type": "console",
      "enabled": true,
      "config": {
        "isPrimary": true,
        "autoStart": true,
        "showStats": true,
        "colorScheme": "default"
      }
    },
    {
      "id": "web-interface",
      "name": "Web Game Interface",
      "type": "html5",
      "enabled": true,
      "config": {
        "isPrimary": false,
        "autoStart": true,
        "port": 3030,
        "title": "X+1 Game - Web Interface",
        "theme": "dark",
        "enableDevTools": true
      }
    }
  ]
}
