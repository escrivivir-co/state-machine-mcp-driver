{
  "name": "state-machine-mcp-driver",
  "version": "1.0.0",
  "description": "Node.js service to handle state machines via MCP protocol",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:mcp": "npx tsx scripts/test-mcp-integration.ts",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "clean": "rimraf dist",
    "example:x-plus-1": "npx tsx examples/x-plus-1-state-machine/index.ts",
    "launcher": "npx tsx scripts/launcher.ts",
    "launcher:x-plus-1": "npx tsx scripts/launcher.ts x-plus-1",
    "mcp:xplus1": "npx tsx src/mcp-servers/XPlus1MCPMachine.ts",
    "mcp:wiki": "npx tsx src/mcp-servers/WikiMCPBrowser.ts",
    "mcp:launcher": "npx tsx src/mcp-servers/MCPServiceLauncher.ts",
    "vscode:config": "npx tsx scripts/generate-vscode-config.ts",
    "vscode:config:check": "npx tsx scripts/generate-vscode-config.ts --check",
    "example": "cross-env OLLAMA_MODEL=gpt-oss:20b MCP_USE_NATIVE_PROTOCOL=true npm run launcher:x-plus-1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/escrivivir-co/state-machine-mcp-driver"
  },
  "keywords": [
    "state-machine",
    "mcp",
    "model-context-protocol",
    "typescript",
    "nodejs"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.17.4",
    "axios": "^1.6.0",
    "express": "^4.18.2",
    "uuid": "^9.0.1",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.17",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.9.0",
    "@types/uuid": "^9.0.7",
    "@typescript-eslint/eslint-plugin": "^6.12.0",
    "@typescript-eslint/parser": "^6.12.0",
    "axios-mock-adapter": "^2.1.0",
    "cross-env": "^7.0.3",
    "eslint": "^8.54.0",
    "jest": "^29.7.0",
    "rimraf": "^5.0.5",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.1",
    "tsx": "^4.20.5",
    "typescript": "^5.3.2"
  }
}
