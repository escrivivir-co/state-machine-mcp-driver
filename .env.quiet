# Quiet Mode Configuration  
# Copy this to .env to enable quiet logging

# Disable verbose MCP logging
MCP_VERBOSE=false

# Enable quiet mode (minimal logging)
MCP_QUIET=true

# Set log level to warn (only important messages)
LOG_LEVEL=warn

# Optional: Enable native MCP protocol
MCP_USE_NATIVE_PROTOCOL=true

# Optional: Set Ollama model
OLLAMA_MODEL=gpt-oss:20b
