{
  "uiInstances": [
    {
      "id": "webrtc-ui-01",
      "type": "webrtc",
      "enabled": true,
      "config": {
        "port": 8083,
        "provideTemplate": true,
        "autoOpenBrowser": false,
        "corsOrigin": "*",
        "debugMode": true,
        "maxConnections": 25,
        "enableSignaling": true,
        "iceServers": [
          { "urls": "stun:stun.l.google.com:19302" },
          { "urls": "stun:stun1.l.google.com:19302" }
        ],
        "roomSettings": {
          "maxRoomsPerUser": 3,
          "defaultRoomType": "public",
          "autoCleanupInterval": 300000
        }
      }
    }
  ],
  "globalSettings": {
    "enableMetrics": true,
    "logLevel": "info",
    "maxConcurrentUIs": 5
  }
}
